# AmoCRM OAuth credentials
AMO_CLIENT_ID=your_integration_client_id
AMO_CLIENT_SECRET=your_integration_client_secret
AMO_REDIRECT_URI=https://raspredelenie.koagency.ru/oauth/callback

# Storage path for queue state and settings (writable directory)
STORAGE_PATH=/var/www/deal-dist/storage

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Общий секрет виджет↔бэкенд. Передаётся заголовком X-Security-Key.
# То же значение впиши в настройках виджета (поле «Security key»).
WIDGET_SECRET=change_me_to_a_random_string

# Требовать X-Security-Key на маршрутах /api/*. Включай ТОЛЬКО когда ключ
# прописан и здесь (WIDGET_SECRET), и в настройках виджета — иначе /api ответит 401.
# Вебхук amoCRM (/webhook/leads), /health и /oauth/callback проверку не проходят.
WIDGET_SECURITY_ENFORCE=false
